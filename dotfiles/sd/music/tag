def text(value) -> str:
    return (value.decode("utf-8", "replace") if isinstance(value, bytes) else str(value)).strip()


class Song:
    def __init__(self, path: Path):
        self.path = path
        self.file = mutagen.File(path)
        if self.file is None:
            raise mutagen.MutagenError("unsupported file type")
        if self.file.tags is None:
            self.file.add_tags()
        self.mp4 = isinstance(self.file, MP4)
        self.keys = MP4_KEYS if self.mp4 else VORBIS_KEYS

    def get(self, field: str) -> list[str]:
        key = self.keys[field]
        if self.mp4:  # freeform atom names are matched case-insensitively by readers
            values = next((v for k, v in self.file.tags.items() if k.casefold() == key.casefold()), [])
        else:
            values = self.file.tags.get(key, [])
        return [t for t in map(text, values) if t and t != "0"]

    def first(self, field: str) -> str:
        return next(iter(self.get(field)), "")

    def set(self, field: str, values: list[str]) -> None:
        key = self.keys[field]
        if self.mp4 and field == "bpm":
            self.file.tags[key] = [int(values[0])]
        elif self.mp4 and key.startswith("----:"):
            self.file.tags[key] = [MP4FreeForm(v.encode()) for v in values]
        else:
            self.file.tags[key] = values

    def unset(self, field: str) -> None:
        key = self.keys[field]
        # Iterating a Vorbis comment yields (key, value) pairs rather than
        # keys, and its pop() takes no default, so go through keys() and
        # delete only what is actually there.
        for stored in [k for k in self.file.tags.keys() if k.casefold() == key.casefold()]:
            del self.file.tags[stored]

    def save(self) -> None:
        self.file.save()


DB_PATH = MUSIC_DIR / "tag.db"
# How long a "nothing found" answer is trusted before asking again. Sources
# do gain lyrics and metadata over time, just not quickly.
MISS_TTL = 90 * 86400


class Attempts:
    """Remembers what was already looked up, so runs stay cheap.

    Without this every run re-queries the ~1200 tracks that have no lyrics
    anywhere, which is both slow and the reason LRCLIB starts shedding with
    503s. A miss is cached for MISS_TTL; an error is not cached at all, so
    transient failures are retried on the very next run.
    """

    def __init__(self, path: Path = DB_PATH, retry_misses: bool = False):
        self.retry_misses = retry_misses
        self.db = sqlite3.connect(path)
        self.db.execute(
            "CREATE TABLE IF NOT EXISTS attempt ("
            "  path TEXT NOT NULL, field TEXT NOT NULL, outcome TEXT NOT NULL,"
            "  detail TEXT, tried_at REAL NOT NULL, tries INTEGER NOT NULL DEFAULT 1,"
            "  PRIMARY KEY (path, field))"
        )
        self.db.commit()

    def skip(self, path: Path, field: str) -> bool:
        """True while a recent "not found" answer is still trusted."""
        if self.retry_misses:
            return False
        row = self.db.execute(
            "SELECT outcome, tried_at FROM attempt WHERE path = ? AND field = ?", (str(path), field)
        ).fetchone()
        return bool(row) and row[0] == "miss" and time.time() - row[1] < MISS_TTL

    def record(self, path: Path, field: str, outcome: str, detail: str = "") -> None:
        self.db.execute(
            "INSERT INTO attempt (path, field, outcome, detail, tried_at) VALUES (?, ?, ?, ?, ?) "
            "ON CONFLICT (path, field) DO UPDATE SET"
            "  outcome = excluded.outcome, detail = excluded.detail,"
            "  tried_at = excluded.tried_at, tries = attempt.tries + 1",
            (str(path), field, outcome, detail, time.time()),
        )

    def commit(self) -> None:
        self.db.commit()


RETRY_STATUS = {429, 500, 502, 503, 504}
RETRIES = 5


def get_json(session: requests.Session, url: str, params: dict, pace: float = 0.0, last: float = 0.0) -> tuple:
    """GET with backoff on the statuses that mean "ask again later".

    Both MusicBrainz (one request per second) and LRCLIB (sheds load with
    503 ServerOverloaded under no particular quota) need this; without it a
    busy minute silently looks like "nothing found" and the field is left
    empty for good.

    Returns (json, last request time) so callers can keep pacing themselves.
    """
    for attempt in range(RETRIES):
        time.sleep(max(0.0, last + pace - time.monotonic()))
        last = time.monotonic()
        r = session.get(url, params=params, timeout=30)
        if r.status_code not in RETRY_STATUS:
            break
        if attempt < RETRIES - 1:
            # Honour Retry-After when the server sends one, else exponential.
            wait = r.headers.get("Retry-After")
            time.sleep(float(wait) if wait and wait.isdigit() else 2**attempt)
    r.raise_for_status()
    return r.json(), last


class MusicBrainz:
    API = "https://musicbrainz.org/ws/2"
    INTERVAL = 1.0  # MusicBrainz allows one request per second

    def __init__(self, session: requests.Session):
        self.session = session
        self.last = 0.0
        self.cache: dict[str, dict] = {}

    def get(self, path: str, **params) -> dict:
        data, self.last = get_json(
            self.session, f"{self.API}/{path}", {"fmt": "json", **params}, self.INTERVAL, self.last
        )
        return data

    def lookup(self, entity: str, mbid: str, inc: str) -> dict:
        key = f"{entity}/{mbid}"
        if key not in self.cache:
            self.cache[key] = self.get(key, inc=inc)
        return self.cache[key]

    def recordings(self, artist: str, title: str) -> list[dict]:
        query = f'recording:"{lucene(title)}" AND artist:"{lucene(artist)}"'
        data = self.get("recording", query=query, limit=10)
        return [r for r in data.get("recordings", []) if r.get("score", 0) >= 90]

    def release_group_years(self, artist: str, title: str) -> list[str]:
        """Years of the single/EP/album release groups named after the song.

        Release groups carry a reliable first-release-date, while the one on
        a recording often belongs to a later reissue.
        """
        query = f'release:"{lucene(title)}" AND artist:"{lucene(artist)}"'
        data = self.get("release-group", query=query, limit=25)
        return [
            year
            for group in data.get("release-groups", [])
            if group.get("score", 0) >= 90
            and not group.get("secondary-types")
            and group.get("primary-type") in ("Single", "Album", "EP")
            for year in [year_of(group.get("first-release-date"))]
            if year
        ]

    def artist_id(self, name: str) -> str | None:
        """Id of the only artist called exactly `name`, None if unknown or ambiguous."""
        data = self.get("artist", query=f'artist:"{lucene(name)}"', limit=10)
        exact = [a["id"] for a in data.get("artists", []) if a["name"].casefold() == name.casefold()]
        return exact[0] if len(exact) == 1 else None

    def country(self, artist_id: str) -> str | None:
        artist = self.lookup("artist", artist_id, "genres")
        area = artist.get("area") or artist.get("begin-area")
        # areas can be cities or regions: walk up "part of" until a country
        for _ in range(6):
            if not area:
                return None
            if area.get("iso-3166-1-codes"):
                return area["name"]
            relations = self.lookup("area", area["id"], "area-rels").get("relations", [])
            area = next(
                (r["area"] for r in relations if r["type"] == "part of" and r["direction"] == "backward"),
                None,
            )
        return None


class Lrclib:
    API = "https://lrclib.net/api/search"
    MAX_DURATION_DIFF = 3  # seconds; synced lyrics only fit the same cut

    def __init__(self, session: requests.Session):
        self.session = session

    def lyrics(self, artist: str, title: str, duration: float) -> str | None:
        results, _ = get_json(self.session, self.API, {"artist_name": artist, "track_name": title})
        same_cut = [x for x in results if abs((x.get("duration") or 0) - duration) <= self.MAX_DURATION_DIFF]
        if any(x.get("instrumental") for x in same_cut):
            return None
        for x in same_cut:
            if x.get("syncedLyrics"):
                return x["syncedLyrics"]
        for x in same_cut:
            if x.get("plainLyrics"):
                return x["plainLyrics"]
        # other cut (edit, remix) of the same song: plain lyrics still fit
        for x in results:
            if (
                x.get("plainLyrics")
                and x.get("trackName", "").casefold() == title.casefold()
                and artist.casefold() in x.get("artistName", "").casefold()
            ):
                return x["plainLyrics"]
        return None


def lyric_lines(lyrics: str) -> list[tuple[str, str]]:
    """Split LRC lyrics into (timestamp prefix, text) pairs.

    Translating the whole blob at once would lose the timestamps, and
    translating line by line would cost one request per line, so the
    prefixes are stripped here, the texts are sent together, and the
    prefixes are put back afterwards.
    """
    pairs = []
    for line in lyrics.splitlines():
        match = re.match(r"((?:\[\d+:\d+(?:[.:]\d+)?\])+)?(.*)", line)
        stamp, body = match.group(1) or "", match.group(2).strip()
        # LRC metadata headers ("[ar:...]", "[by:...]") are not lyrics and
        # must not be sent off for translation.
        if re.fullmatch(r"\[[a-z]+:[^]]*\]", body):
            stamp, body = stamp + body, ""
        pairs.append((stamp, body))
    return pairs


def detect_language(lyrics: str) -> str | None:
    """Language of the lyrics, or None if there is too little to tell."""
    body = "\n".join(t for stamp, t in lyric_lines(lyrics) if t and not re.fullmatch(r"\[[a-z]+:[^]]*\]", t))
    if len(body) < MIN_LYRICS_CHARS:
        return None
    from langdetect import DetectorFactory, detect_langs
    from langdetect.lang_detect_exception import LangDetectException

    DetectorFactory.seed = 0  # langdetect is non-deterministic otherwise
    try:
        best = detect_langs(body)[0]
    except LangDetectException:
        return None
    return best.lang if best.prob >= MIN_LANGUAGE_CONFIDENCE else None


class DeepL:
    """Translates lyrics, keeping their LRC timestamps.

    Free and Pro keys use different hosts; free keys are suffixed ":fx".
    """

    def __init__(self, session: requests.Session, key: str):
        self.session = session
        self.key = key
        host = "api-free" if key.endswith(":fx") else "api"
        self.url = f"https://{host}.deepl.com/v2/translate"
        self.languages_url = f"https://{host}.deepl.com/v2/languages"
        self._sources: set[str] | None = None

    @property
    def sources(self) -> set[str]:
        """Source languages DeepL accepts, asked once per run.

        langdetect happily reports languages DeepL has never heard of
        ("so" for 300 characters of repetitive English), and sending one
        fails the whole request with a 400.
        """
        if self._sources is None:
            r = self.session.post(
                self.languages_url,
                headers={"Authorization": f"DeepL-Auth-Key {self.key}"},
                data={"type": "source"},
                timeout=30,
            )
            r.raise_for_status()
            self._sources = {x["language"].casefold() for x in r.json()}
        return self._sources

    @classmethod
    def from_file(cls, session: requests.Session, path: Path = DEEPL_KEY_FILE) -> "DeepL | None":
        """None when no key is installed, so tagging still works without one."""
        try:
            key = path.read_text().strip()
        except OSError:
            return None
        return cls(session, key) if key else None

    def translate(self, lyrics: str, source: str) -> str | None:
        if source not in self.sources:
            return None
        pairs = lyric_lines(lyrics)
        texts = [t for _, t in pairs if t]
        if not texts:
            return None
        for attempt in range(RETRIES):
            r = self.session.post(
                self.url,
                # The auth_key form field is deprecated and now rejected.
                headers={"Authorization": f"DeepL-Auth-Key {self.key}"},
                data=[("text", t) for t in texts] + [("target_lang", "EN"), ("source_lang", source.upper())],
                timeout=60,
            )
            if r.status_code not in RETRY_STATUS:
                break
            if attempt < RETRIES - 1:
                time.sleep(2**attempt)
        r.raise_for_status()
        done = iter(x["text"] for x in r.json()["translations"])
        return "\n".join(stamp + (next(done) if t else "") for stamp, t in pairs).strip()


MODELS_URL = "https://essentia.upf.edu/models"
MODELS_DIR = Path.home() / ".cache/music-tag"
EMBEDDING_MODEL = "feature-extractors/discogs-effnet/discogs-effnet-bs64-1"
GENRE_MODEL = "classification-heads/genre_discogs400/genre_discogs400-discogs-effnet-1"
MOODS = ("aggressive", "happy", "party", "relaxed", "sad")
# Discogs style activations are sigmoids that rarely pass ~0.3; keep the top
# style if it's not noise and a runner-up if it's at least half as likely.
AUDIO_GENRE_MIN = 0.05
AUDIO_GENRE_RELATIVE = 0.5


def decode(path: Path, sample_rate: int) -> np.ndarray:
    """Mono float32 samples. Essentia's own loader can't decode Opus."""
    proc = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", str(path), "-f", "f32le", "-ac", "1", "-ar", str(sample_rate), "-"],
        stdin=subprocess.DEVNULL,  # ffmpeg would otherwise read keystrokes from the terminal
        capture_output=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(f"ffmpeg: {proc.stderr.decode(errors='replace').strip()}")
    return np.frombuffer(proc.stdout, dtype=np.float32)


class Analyzer:
    """BPM, mood and genre from the audio with Essentia."""

    def __init__(self, session: requests.Session):
        os.environ.setdefault("TF_CPP_MIN_LOG_LEVEL", "3")
        import essentia
        import essentia.standard as es

        essentia.log.infoActive = False
        essentia.log.warningActive = False
        self.es = es
        self.session = session
        self.embedder = es.TensorflowPredictEffnetDiscogs(
            graphFilename=str(self.model(EMBEDDING_MODEL, ".pb")), output="PartitionedCall:1"
        )
        self.genre_classes = json.loads(self.model(GENRE_MODEL, ".json").read_text())["classes"]
        self.genre_head = es.TensorflowPredict2D(
            graphFilename=str(self.model(GENRE_MODEL, ".pb")),
            input="serving_default_model_Placeholder",
            output="PartitionedCall:0",
        )
        self.mood_heads = {}
        for mood in MOODS:
            name = f"classification-heads/mood_{mood}/mood_{mood}-discogs-effnet-1"
            classes = json.loads(self.model(name, ".json").read_text())["classes"]
            head = es.TensorflowPredict2D(graphFilename=str(self.model(name, ".pb")), output="model/Softmax")
            self.mood_heads[mood] = (head, classes.index(mood))

    def model(self, name: str, ext: str) -> Path:
        path = MODELS_DIR / f"{name}{ext}"
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            r = self.session.get(f"{MODELS_URL}/{name}{ext}", timeout=300)
            r.raise_for_status()
            tmp = path.with_suffix(".part")
            tmp.write_bytes(r.content)
            tmp.replace(path)
        return path

    def analyze(self, path: Path, fields: set[str]) -> dict[str, list[str]]:
        es = self.es
        audio = decode(path, 44100)
        result = {}
        if "bpm" in fields:
            bpm = es.PercivalBpmEstimator(sampleRate=44100)(audio)
            result["bpm"] = [str(round(bpm))] if bpm > 0 else []
        if fields & {"genre", "mood"}:
            audio16k = es.Resample(inputSampleRate=44100, outputSampleRate=16000, quality=4)(audio)
            embeddings = self.embedder(audio16k)
            if "genre" in fields:
                activations = self.genre_head(embeddings).mean(axis=0)
                result["genre"] = self.genres(activations)
            if "mood" in fields:
                scores = {m: float(head(embeddings).mean(axis=0)[i]) for m, (head, i) in self.mood_heads.items()}
                moods = [m for m, s in sorted(scores.items(), key=lambda kv: -kv[1]) if s >= 0.5]
                result["mood"] = [m.title() for m in moods or [max(scores, key=scores.get)]]
        return result

    def genres(self, activations) -> list[str]:
        """Top Discogs styles ("Electronic---Deep House") plus their parent genres."""
        top = sorted(range(len(activations)), key=lambda i: -activations[i])[:2]
        cutoff = max(AUDIO_GENRE_MIN, activations[top[0]] * AUDIO_GENRE_RELATIVE)
        styles = [self.genre_classes[i].split("---") for i in top if activations[i] >= cutoff]
        return list(dict.fromkeys([style for _, style in styles] + [parent for parent, _ in styles]))


def lucene(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


# yt-dlp writes the *upload* date as a bare YYYYMMDD, so a 1992 song ripped
# from YouTube in 2022 carries "20220520". Those are the only dates we treat
# as missing and overwrite; a real year or an ISO date is left alone.
UPLOAD_DATE = re.compile(r"^\d{8}$")


def is_upload_date(value: str) -> bool:
    return bool(UPLOAD_DATE.match(value))


def year_of(value: str | None) -> str | None:
    match = re.match(r"(\d{4})", value or "")
    return match.group(1) if match else None


def studio_years(recordings: list[dict]) -> list[str]:
    """Release years of the studio recordings among `recordings`.

    A title search is dominated by live cuts and bootlegs, whose dates are
    later than the original and often plain wrong (MusicBrainz has a live
    "Hello" by Adele dated 2005), so taking the earliest date over
    everything picks up junk. Live takes are dropped, and a release only
    counts if its group is an ordinary album/single/EP - `secondary-types`
    marks the compilation and remix reissues.
    """
    years = []
    for rec in recordings:
        if "live" in (rec.get("disambiguation") or "").casefold():
            continue
        if year := year_of(rec.get("first-release-date")):
            years.append(year)
        for rel in rec.get("releases", []):
            group = rel.get("release-group", {})
            if group.get("secondary-types") or not group.get("primary-type"):
                continue
            if year := year_of(group.get("first-release-date")):
                years.append(year)
    return years


JUNK = re.compile(
    r"\s*[(\[][^)\]]*\b(official|video|audio|lyrics?|visuali[sz]er|hd|4k|remaster(ed)?|feat\.?|ft\.?)(\W|$)[^)\]]*[)\]]",
    re.IGNORECASE,
)
FEAT = re.compile(r"\s+(feat\.?|ft\.?|featuring|,)\s+.*$", re.IGNORECASE)


def search_terms(artist: str, title: str) -> list[tuple[str, str]]:
    """(artist, title) pairs to try, most specific first."""
    terms = [(artist, title)]
    if " - " in title:  # "Artist - Title" uploads
        a, t = title.split(" - ", 1)
        terms.append((a, t))
    cleaned = [(FEAT.sub("", a).strip(), JUNK.sub("", t).strip()) for a, t in terms]
    bare = [(a, re.sub(r"\s*[(\[].*?[)\]]", "", t).strip()) for a, t in cleaned]
    return list(dict.fromkeys((a, t) for a, t in terms + cleaned + bare if a and t))


def pick_genres(genres: list[dict]) -> list[str]:
    ranked = sorted(genres, key=lambda g: -g.get("count", 0))
    # .title() matches beets' lastgenre casing used for the existing tags
    return [g["name"].title() for g in ranked[:MAX_GENRES]]


def is_junk_genre(values: list[str]) -> bool:
    """True when the genre tag holds nothing but placeholders."""
    return bool(values) and all(v.casefold() in JUNK_GENRES for v in values)


class Tagger:
    def __init__(self, attempts: Attempts | None = None):
        self.session = requests.Session()
        self.session.headers["User-Agent"] = USER_AGENT
        self.mb = MusicBrainz(self.session)
        self.lrclib = Lrclib(self.session)
        self.deepl = DeepL.from_file(self.session)
        self.attempts = attempts
        self._analyzer: Analyzer | None = None

    @property
    def analyzer(self) -> Analyzer:
        if self._analyzer is None:
            self._analyzer = Analyzer(self.session)
        return self._analyzer

    def match(self, terms: list[tuple[str, str]]) -> tuple[list[dict], str | None]:
        """Matching MusicBrainz recordings and the artist id."""
        for a, t in terms:
            if recordings := self.mb.recordings(a, t):
                credits = recordings[0].get("artist-credit", [])
                return recordings, credits[0]["artist"]["id"] if credits else None
        for a in dict.fromkeys(a for a, _ in terms):
            if artist_id := self.mb.artist_id(a):
                return [], artist_id
        return [], None

    def mb_genres(self, recordings: list[dict], artist_id: str | None, album: str) -> list[str]:
        if not recordings:  # an artist-only match says nothing about this song
            return []
        release_groups = [
            rel["release-group"]
            for rec in recordings
            for rel in rec.get("releases", [])
            # skip compilations, live albums, remix albums, ...
            if rel.get("release-group", {}).get("primary-type") and not rel["release-group"].get("secondary-types")
        ]
        release_groups.sort(key=lambda rg: rg.get("title", "").casefold() != album.casefold())
        for rgid in list(dict.fromkeys(rg["id"] for rg in release_groups))[:3]:
            if genres := self.mb.lookup("release-group", rgid, "genres").get("genres"):
                return pick_genres(genres)
        if artist_id:
            return pick_genres(self.mb.lookup("artist", artist_id, "genres").get("genres", []))
        return []

    def lyrics(self, terms: list[tuple[str, str]], duration: float) -> str | None:
        for a, t in terms:
            if lyrics := self.lrclib.lyrics(a, t, duration):
                return lyrics
        return None

    def tag(self, song: Song, fields: list[str]) -> tuple[dict[str, list[str]], list[str]]:
        """Values for the missing fields (empty list = nothing found) and lookup errors.

        A failing source only drops its own fields, so they're retried next run.
        """
        missing = [f for f in fields if not song.get(f)]
        # A YouTube upload date is not a release year, so count it as missing
        # even though the tag is technically set.
        if "year" in fields and "year" not in missing and is_upload_date(song.first("year")):
            missing.append("year")
        # Same for a genre tag that only holds YouTube's "Music" category.
        if "genre" in fields and "genre" not in missing and is_junk_genre(song.get("genre")):
            missing.append("genre")
        # yt-dlp's LANGUAGE tag is a claim, not a fact (see ISO_639_2 above),
        # so every existing one is re-checked against the lyrics. It is only
        # actually replaced if detection is confident and disagrees.
        if "language" in fields and "language" not in missing:
            missing.append("language")
        if self.attempts:  # don't re-ask for what was recently not found
            missing = [f for f in missing if not self.attempts.skip(song.path, f)]
        title = song.first("title") or song.path.stem
        terms = search_terms(song.first("artist"), title)
        updates: dict[str, list[str]] = {}
        errors: list[str] = []
        if {"genre", "country", "year"} & set(missing):
            try:
                recordings, artist_id = self.match(terms)
                if "genre" in missing:
                    updates["genre"] = self.mb_genres(recordings, artist_id, song.first("album"))
                if "country" in missing:
                    country = self.mb.country(artist_id) if artist_id else None
                    updates["country"] = [country] if country else []
                if "year" in missing:
                    years = self.mb.release_group_years(song.first("artist"), title) + studio_years(recordings)
                    updates["year"] = [min(years)] if years else []
            except requests.RequestException as e:
                errors.append(f"musicbrainz: {e}")
        if "lyrics" in missing:
            try:
                lyrics = self.lyrics(terms, song.file.info.length)
                updates["lyrics"] = [lyrics] if lyrics else []
            except requests.RequestException as e:
                errors.append(f"lrclib: {e}")
        # Both remaining fields start from the same detection, so do it once,
        # and only when one of them actually needs it.
        lyrics = language = ""
        if {"language", "lyrics_en"} & set(missing):
            # Whatever the lyrics step just found, else What the file had.
            lyrics = next(iter(updates.get("lyrics", [])), "") or song.first("lyrics")
            language = detect_language(lyrics) if lyrics else None
        if "language" in missing:
            # langdetect returns ISO 639-1; the tag holds 639-2/B. An unmapped
            # code (langdetect knows a few ISO 639-2 does not) counts as no
            # answer rather than being written through.
            code = ISO_639_2.get(language) if language else None
            if code:
                # Only write when this actually says something new, so an
                # already-correct tag is left untouched rather than rewritten
                # (and the file left unsaved) on every nightly Run.
                updates["language"] = [] if code == song.first("language") else [code]
            elif song.get("language"):
                # Undetectable, but the file already claims something. Leave
                # that claim alone: with no lyrics to contradict it there is
                # no basis to call it wrong.
                missing.remove("language")
            elif lyrics:
                # Has lyrics, but no confident language came out of them.
                # Worth remembering so it is not retried every single night.
                updates["language"] = []
            else:
                # No lyrics to judge by yet. As with lyrics_en below, record
                # nothing so the track is reconsidered once LRCLIB has them,
                # instead of being written off for MISS_TTL.
                missing.remove("language")
        if "lyrics_en" in missing and self.deepl:
            if language and language not in KEEP_LANGUAGES:
                try:
                    translated = self.deepl.translate(lyrics, language)
                    updates["lyrics_en"] = [translated] if translated else []
                except requests.RequestException as e:
                    errors.append(f"deepl: {e}")
            elif lyrics:
                # English, German or unidentifiable: nothing to translate,
                # and recording it stops it being reconsidered every night.
                updates["lyrics_en"] = []
            else:
                # No lyrics *yet*. Caching a miss here would keep the track
                # untranslated for 90 days after LRCLIB finally finds them,
                # and re-checking costs nothing, so record nothing.
                missing.remove("lyrics_en")
        audio_fields = {f for f in ("bpm", "mood") if f in missing}
        if updates.get("genre") == []:  # MusicBrainz answered, but has no genre
            audio_fields.add("genre")
        if audio_fields:
            try:
                updates |= self.analyzer.analyze(song.path, audio_fields)
            except RuntimeError as e:  # ffmpeg or essentia
                errors.append(f"analysis: {e}")
        if self.attempts:
            for field in missing:
                if field not in updates:  # its source raised, so nothing was learned
                    self.attempts.record(song.path, field, "error", "; ".join(errors)[:300])
                else:
                    self.attempts.record(song.path, field, "found" if updates[field] else "miss")
        return updates, errors


def summary(field: str, values: list[str]) -> str:
    if not values:
        return f"{field}=-"
    if field in ("lyrics", "lyrics_en"):  # lyrics are far too long to print
        return f"{field}=" + ("synced" if re.match(r"\[\d+:\d+", values[0]) else "plain")
    return f"{field}={'; '.join(values)}"


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("dir", nargs="?", type=Path, default=MUSIC_DIR)
    parser.add_argument(
        "-f",
        "--fields",
        default=",".join(FIELDS),
        type=lambda s: [f for f in FIELDS if f in s.split(",")],
        help=f"comma-separated subset of {','.join(FIELDS)} (default: all)",
    )
    parser.add_argument("-n", "--dry-run", action="store_true", help="print what would be tagged, write nothing")
    parser.add_argument(
        "--retry-misses",
        action="store_true",
        help="also look up fields that were recently not found (see tag.db)",
    )
    args = parser.parse_args()

    files = sorted(p for p in args.dir.rglob("*") if p.suffix.lower() in EXTENSIONS)
    attempts = Attempts(retry_misses=args.retry_misses)
    tagger = Tagger(attempts)
    found = dict.fromkeys(args.fields, 0)
    missed = dict.fromkeys(args.fields, 0)
    for i, path in enumerate(files, 1):
        name = path.relative_to(args.dir)
        try:
            song = Song(path)
            updates, errors = tagger.tag(song, args.fields)
            for error in errors:
                print(f"[{i}/{len(files)}] {name}: error: {error}", file=sys.stderr, flush=True)
            if not updates:
                continue
            print(f"[{i}/{len(files)}] {name}: " + " | ".join(summary(f, v) for f, v in updates.items()), flush=True)
            dropped = False
            for field, values in updates.items():
                if values:
                    found[field] += 1
                    song.set(field, values)
                else:
                    missed[field] += 1
                    # Nothing better was found, but a placeholder genre is
                    # worse than none: it is not a genre and it hides the
                    # track from genre browsing.
                    if field == "genre" and is_junk_genre(song.get("genre")):
                        song.unset(field)
                        dropped = True
            if not args.dry_run:
                if any(updates.values()) or dropped:
                    song.save()
                # Persist per file: a long run that is interrupted keeps
                # what it learned instead of starting over.
                attempts.commit()
        except mutagen.MutagenError as e:
            print(f"[{i}/{len(files)}] {name}: error: {e}", file=sys.stderr, flush=True)
    verb = "would tag" if args.dry_run else "tagged"
    print(f"{len(files)} files; {verb}: " + ", ".join(f"{f} {found[f]} (not found {missed[f]})" for f in args.fields))


if __name__ == "__main__":
    main()

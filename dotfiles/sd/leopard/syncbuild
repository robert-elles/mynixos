#!/usr/bin/env bash
set -euo pipefail

# macOS default soft fd limit (256) is too low for nix flake update's git
# fetcher against the tarball cache. Raise it; hard limit is unlimited.
ulimit -n 1048576 2>/dev/null || true
LEOPARD=~/Nextcloud/code/mynixos/machines/leopard

# Original sync and build logic
if [[ " $* " == *" update "* ]]; then
    # Pin the nixpkgs of the last committed flake.lock (the working one) before
    # updating. The local flake.lock may already hold an untested update from
    # an earlier `update` Run.
    CURRENT_NIXPKGS_REV=$(git -C ~/Nextcloud/code/mynixos show HEAD:machines/leopard/flake.lock | jq -r '.nodes.nixpkgs.locked.rev')
    if [[ -n "$CURRENT_NIXPKGS_REV" && "$CURRENT_NIXPKGS_REV" != "null" ]]; then
        echo "Pinning current nixpkgs ($CURRENT_NIXPKGS_REV) to nixpkgs_pin..."
        sed -i '' "s|nixpkgs_pin.url = \"github:nixos/nixpkgs/[a-f0-9]*\";|nixpkgs_pin.url = \"github:nixos/nixpkgs/$CURRENT_NIXPKGS_REV\";|" "$LEOPARD/flake.nix"
    fi

    pushd $LEOPARD || exit
    nix flake update
    # nix flake lock --update-input home-manager
    # nix flake lock --update-input nixos-hardware
    popd || exit

    # Packages the updated config would build from source are taken from
    # nixpkgs_pin instead (see machines/leopard/pinned-packages.nix), if
    # their pinned version is cached. Evaluated on leopard, which has the
    # substituters and the local store the build will use.
    rsync -rvhtz ~/Nextcloud/code/mynixos/ leopard:Nextcloud/code/mynixos/
    ssh leopard bash Nextcloud/code/mynixos/dotfiles/sd/leopard/uncached-pins
    rsync -vht leopard:Nextcloud/code/mynixos/machines/leopard/pinned-packages.json "$LEOPARD/"
    echo "Pinned to nixpkgs_pin: $(jq -r 'join(" ")' "$LEOPARD/pinned-packages.json")"
# else
#     pushd ~/Nextcloud/code/mynixos/machines/leopard || exit
#     nix flake lock --update-input mynixosp
#     popd || exit
fi

rsync -rvhtz ~/Nextcloud/code/mynixos/ leopard:Nextcloud/code/mynixos/
# rsync -rvhtz ~/code/jules/ falcon:code/jules/ --exclude data --exclude webdata/.scrapy/httpcache --exclude webdata/data

args=("$@")
# remove update from args if it exists
args=("${args[@]/update}")

buildarg="boot"
if [[ " ${args[*]} " == *" switch "* ]]; then
    buildarg="switch"
fi

if [[ " $* " == *" build "* || " $* " == *" switch "* ]]; then

    echo "Building"

    "$(dirname "${BASH_SOURCE[0]}")/rebuild" "$buildarg"

fi



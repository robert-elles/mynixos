#!/usr/bin/env bash
# Open a new window of an app on the currently focused Hyprspace workspace.
#
# Hyprspace's built-in `new-window-or-open` matches menu items against
# hardcoded English strings ("new window", "file / new"), so it never matches
# on a German macOS UI. This drives the locale-agnostic `app-menu` command
# instead, and reimplements the workspace-restore step that `app-menu` lacks.
#
# Usage: newwindow <bundle-id> <menu-leaf-pattern> <app-name>

set -u

bundle_id=$1
leaf_pattern=$2
app_name=$3

hs=/opt/homebrew/bin/hyprspace

ws=$("$hs" list-workspaces --focused)
before=$("$hs" list-windows --all --format '%{window-id}' | sort)

if [ "$bundle_id" = com.apple.Terminal ] && pgrep -xq Terminal; then
  # Terminal's "Neues Fenster" menu item ends up as a native tab of the focused
  # window (system-wide AppleWindowTabbingMode / Terminal's own tab logic
  # ignores the per-app "manual" setting). `do script` always makes a real
  # standalone window.
  osascript -e 'tell application "Terminal" to do script ""' >/dev/null
# Non-zero covers both "app not running" (exit 2) and "no menu match" (--click-first).
elif ! "$hs" app-menu --app-bundle-id "$bundle_id" \
     --match-leaf "$leaf_pattern" --click-first 2>/dev/null; then
  # `open` passes our environment to the launched app. Drop the nix-darwin /
  # home-manager "already sourced" guards, otherwise the app's login shells
  # (PATH reset by login(1)) skip the nix environment setup.
  env -u __NIX_DARWIN_SET_ENVIRONMENT_DONE -u __HM_SESS_VARS_SOURCED \
      -u __HM_ZSH_SESS_VARS_SOURCED open -a "$app_name"
fi

new_id=""
for _ in $(seq 1 20); do
  sleep 0.1
  after=$("$hs" list-windows --all --format '%{window-id}' | sort)
  new_id=$(comm -13 <(echo "$before") <(echo "$after") | head -1)
  [ -n "$new_id" ] && break
done

if [ -n "$new_id" ]; then
  "$hs" move-node-to-workspace --window-id "$new_id" --focus-follows-window "$ws"
else
  "$hs" workspace "$ws"
fi

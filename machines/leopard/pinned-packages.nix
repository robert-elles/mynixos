# Top-level packages listed in pinned-packages.json are taken from nixpkgs_pin,
# i.e. the nixpkgs revision of the flake.lock before the last
# `sd leopard syncbuild update`. The list is regenerated by syncbuild on every
# update: it contains the packages the updated config would otherwise have to
# build from source because they are not in the binary cache.
#
# The pinned set is imported with this system's nixpkgs.config (cudaSupport,
# allowUnfree, ...) so pinned packages match the previously built ones.
{
  config,
  lib,
  inputs,
  settings,
  ...
}:
let
  pins = lib.importJSON ./pinned-packages.json;
  pkgsPinned = import inputs.nixpkgs_pin {
    inherit (settings) system;
    config = config.nixpkgs.config;
  };
in
{
  nixpkgs.overlays = [ (_: _: lib.genAttrs pins (n: pkgsPinned.${n})) ];
}
